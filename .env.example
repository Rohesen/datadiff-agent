# Pick one provider. With none set, the agent runs offline (no API key needed).

# Groq (free tier): https://console.groq.com
GROQ_API_KEY=

# Or choose explicitly:
# DATADIFF_AGENT_PROVIDER=groq        # groq | openai | ollama | offline
# DATADIFF_AGENT_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=
# DATADIFF_AGENT_BASE_URL=            # any OpenAI-compatible endpoint

# Optional: post WARN/BLOCK alerts to Slack
# SLACK_WEBHOOK_URL=
